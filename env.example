# ── Server ────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000          # Change to your public domain in production
LINK_EXPIRE_HRS=24                     # How many hours download links are valid

# ── SMTP (Gmail example) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password        # Use Gmail App Password (not your login password)
FROM_EMAIL=your@gmail.com

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET=changeme123               # Used to access /admin/subscribers?secret=...
